# ============================================================
# Enterprise AI Platform production environment example
# Copy to:
# /opt/enterprise-ai-platform/shared/.env.production
# Then replace every CHANGE_ME value.
# Never commit the real production file to Git.
# ============================================================

TZ=Asia/Shanghai
APP_ENV=production
LOG_LEVEL=info

# Version is supplied by deployment scripts.
APP_VERSION=v0.0.0

# PostgreSQL
POSTGRES_DB=enterprise_ai
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_LONG_RANDOM_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_LONG_RANDOM_PASSWORD

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=enterprise_ai
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_LONG_RANDOM_PASSWORD
RABBITMQ_VHOST=enterprise_ai

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=enterprise_ai_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_LONG_RANDOM_PASSWORD
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_REPORTS=reports
MINIO_USE_SSL=false

# Authentication
JWT_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Internal service URLs
AI_SERVICE_URL=http://ai-service:8000
REALTIME_SERVICE_URL=http://realtime-service:8080
NEST_API_URL=http://nest-api:3000

# LLM gateway
LLM_PROVIDER=deepseek
LLM_BASE_URL=CHANGE_ME
LLM_API_KEY=CHANGE_ME
LLM_MODEL=CHANGE_ME

# DB2 read-only data source
DB2_HOST=CHANGE_ME
DB2_PORT=50000
DB2_DATABASE=CHANGE_ME
DB2_USERNAME=CHANGE_ME_READONLY_USER
DB2_PASSWORD=CHANGE_ME
DB2_SCHEMA=CHANGE_ME
