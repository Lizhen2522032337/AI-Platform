# 本文件只是模板。真实文件固定保存在虚拟机：
# /etc/enterprise-ai-platform/platform.env

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=请替换为至少32位随机密码

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=enterprise_ai
RABBITMQ_DEFAULT_PASS=请替换为至少32位随机密码
RABBITMQ_DEFAULT_VHOST=enterprise_ai
RABBITMQ_TASK_QUEUE=ai_tasks

# 内部 AI 服务
AI_SERVICE_URL=http://fastapi-service:8000

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ai_task_vectors

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=enterprise_ai_minio
MINIO_ROOT_PASSWORD=请替换为至少32位随机密码
MINIO_BUCKET=ai-results
MINIO_USE_SSL=false

# 通用日志
LOG_LEVEL=INFO
