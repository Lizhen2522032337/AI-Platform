# 本文件只是模板。真实文件固定保存在虚拟机：
# /etc/enterprise-ai-platform/platform.env

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=请替换为至少32位随机密码

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=enterprise_ai
RABBITMQ_DEFAULT_PASS=请替换为至少32位随机密码
RABBITMQ_DEFAULT_VHOST=enterprise_ai
RABBITMQ_TASK_QUEUE=ai_tasks

# 内部 AI 服务
AI_SERVICE_URL=http://fastapi-service:8000
# 每次多轮请求最多携带最近 10 轮完整问答，可按成本和上下文需要调整为 1-20。
AI_CONTEXT_TURNS=10
# DeepSeek/千问的 API Key 不放在这里，单独保存于：
# /etc/enterprise-ai-platform/llm.env

# 登录认证。JWT_SECRET 至少 32 字节，生产环境必须使用随机值。
JWT_SECRET=请替换为至少64位随机密钥
JWT_ISSUER=enterprise-ai-platform
JWT_AUDIENCE=enterprise-ai-platform-web
JWT_COOKIE_NAME=eai_access
JWT_EXPIRES_SECONDS=3600
# 当前 HTTP 内网部署填 false；启用 HTTPS 后必须改为 true。
COOKIE_SECURE=false

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ai_task_vectors

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=enterprise_ai_minio
MINIO_ROOT_PASSWORD=请替换为至少32位随机密码
MINIO_BUCKET=ai-results
MINIO_USE_SSL=false

# 通用日志
LOG_LEVEL=INFO
