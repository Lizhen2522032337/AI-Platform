# 本文件只是模板，禁止填写真实密码后提交到 Git。
# 真实文件固定保存在虚拟机：/etc/enterprise-ai-platform/database.env
# 使用本项目托管的 PostgreSQL 容器时，POSTGRES_HOST 必须填写 postgres。
# 改用外部数据库时，只需改为外部数据库可达地址，并在 deploy.env 中设置 DATABASE_MODE=external。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai_platform
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=请替换为至少32位随机密码
POSTGRES_SSLMODE=disable
