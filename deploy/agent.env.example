# 本文件只提供 Agent 配置字段，允许提交 Git；严禁填写真实连接串或 Webhook。
# 真实配置固定保存在虚拟机：/etc/enterprise-ai-platform/agent.env
# 创建后执行：chmod 600 /etc/enterprise-ai-platform/agent.env

# LangGraph Agent 总开关与单次任务边界。
AGENT_ENABLED=true
AGENT_MAX_QUERIES=6
AGENT_MAX_EVIDENCE_CHARS=24000

# PostgreSQL 连接参数直接复用 /etc/enterprise-ai-platform/database.env。
# 这里仅控制查询 Tool 的开关、超时和最多返回行数。
POSTGRES_ENABLED=true
POSTGRES_QUERY_TIMEOUT_SECONDS=30
POSTGRES_MAX_ROWS=500

# 通用目录中每个 query_id 可以分别配置 PostgreSQL/DB2 SQL 方言。
DATABASE_CATALOG_FILE=/etc/enterprise-ai-platform/database-catalog.json

# DB2 默认关闭。DB2_DSN 中通常包含账号密码，只能写入虚拟机真实配置。
DB2_ENABLED=false
DB2_DSN=DATABASE=数据库名;HOSTNAME=数据库地址;PORT=50000;PROTOCOL=TCPIP;UID=只读账号;PWD=真实密码;
DB2_QUERY_TIMEOUT_SECONDS=30
DB2_MAX_ROWS=500

# 报告保存到现有 MinIO；消息通知默认关闭且不自动发送。
REPORT_FILES_ENABLED=true
NOTIFICATION_ENABLED=false
NOTIFICATION_AUTO_SEND=false
NOTIFICATION_WEBHOOK_URL=请替换为真实Webhook地址
NOTIFICATION_TIMEOUT_SECONDS=10
