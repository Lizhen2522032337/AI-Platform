# 本文件只保存非敏感部署选项。
# 虚拟机上的真实文件固定为：/etc/enterprise-ai-platform/deploy.env

# 当前从 Git 拉取并部署的分支。
DEPLOY_BRANCH=agent/initial-project

# managed：由本项目的 Docker Compose 启动 PostgreSQL。
# external：使用 database.env 中配置的外部 PostgreSQL，不启动本项目数据库容器。
DATABASE_MODE=managed

# 两个真实配置文件都位于 Git 仓库之外。
DATABASE_ENV_FILE=/etc/enterprise-ai-platform/database.env
PLATFORM_ENV_FILE=/etc/enterprise-ai-platform/platform.env

# 不可变基础镜像锁。首次部署执行 pin-base-images.sh 自动生成。
BASE_IMAGES_FILE=/etc/enterprise-ai-platform/base-images.env

# 单虚拟机默认使用本地镜像命名空间；接入 Harbor/GHCR 后改为企业仓库地址。
# 示例：registry.example.com/enterprise-ai-platform
APP_IMAGE_REGISTRY=enterprise-ai-platform
