# 本文件只是字段模板，允许提交到 Git；严禁填写任何真实 API Key。
# 真实配置固定保存在虚拟机：/etc/enterprise-ai-platform/llm.env
# 创建真实文件后执行：chmod 600 /etc/enterprise-ai-platform/llm.env

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=请替换为真实DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云百炼/通义千问。BASE_URL 与 API Key 的地域和业务空间必须一致。
QWEN_API_KEY=请替换为真实百炼_API_Key
QWEN_BASE_URL=https://你的工作空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 自建 RAG 的向量模型（OpenAI 兼容 Embeddings API）。
# 模型或维度变更后必须重建知识库向量；普通检索参数请改 knowledge-base.json。
EMBEDDING_API_KEY=请替换为真实向量模型_API_Key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
KNOWLEDGE_CONFIG_FILE=/etc/enterprise-ai-platform/knowledge-base.json

# 单次请求控制，避免长时间占用 Worker 或产生不可控费用。
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=2048
