# 本文件只是模板。真实文件固定保存在虚拟机：
# /etc/enterprise-ai-platform/llm.env
#
# 安全要求：不要提交真实 API Key；建议执行 chmod 600。

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=请替换为真实DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云百炼/通义千问。BASE_URL 与 API Key 的地域和业务空间必须一致。
# 请把“你的工作空间ID”替换成百炼控制台显示的 WorkspaceId。
QWEN_API_KEY=请替换为真实百炼_API_Key
QWEN_BASE_URL=https://你的工作空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Dify Knowledge API。Dataset ID 是知识库页面 URL 中的 UUID，不是知识库名称。
# Key 和 Dataset ID 只能保存在虚拟机的 /etc/enterprise-ai-platform/llm.env。
DIFY_ENABLED=true
DIFY_API_KEY=请替换为真实Dify_Knowledge_API_Key
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_DATASET_ID=请替换为知识库Dataset_ID
# 使用知识库自身的检索方式，再从返回结果中过滤最多 4 条、相关度至少 0.3 的文本块。
DIFY_TOP_K=4
DIFY_SCORE_THRESHOLD=0.3
DIFY_REQUEST_TIMEOUT_SECONDS=20
DIFY_MAX_CONTEXT_CHARS=12000

# 单次请求控制，避免长时间占用 Worker 或产生不可控费用。
LLM_REQUEST_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=2048
