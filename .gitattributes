* text=auto

# Linux 部署和容器配置必须使用 LF，避免虚拟机执行时出现 ^M 错误。
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Python 依赖锁文件会在 Windows 生成、Linux 校验，统一使用 LF，避免哈希因换行符不同而失效
requirements*.txt text eol=lf
requirements*.lock text eol=lf
python-lock.manifest.sha256 text eol=lf

# Windows 自动化脚本统一使用 CRLF。
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不参与文本换行转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.gz binary
