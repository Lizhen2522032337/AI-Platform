# 数据库真实配置固定保存在虚拟机 /etc/enterprise-ai-platform，不进入仓库。
# 兼容旧部署产生的仓库内文件，防止误提交凭据与状态。
deploy/.env
deploy/.state/

# 所有真实环境文件与私钥均不得提交；不仅保护“.env”，也保护“llm.env”等命名。
*.env
*.env.*
# 只有以 example 结尾且内容为占位符的模板允许进入仓库。
!*.env.example
!*.env.*.example
# 关键文件再显式列出一遍，避免以后调整通配规则时误提交。
deploy/llm.env
deploy/database.env
deploy/platform.env
deploy/deploy.env
*.pem
*.npm-cache
*.key
*.p12
*.pfx
secrets/

# 常见本地依赖、缓存和构建产物。
node_modules/
.npm-cache/
dist/
build/
coverage/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.go-cache/
.venv/
venv/

# 本地编辑器、系统文件与发布产物。
.idea/
.vscode/
.DS_Store
Thumbs.db
release-output/
*.tar
*.tar.gz
*.sha256
# Python 依赖入口与 lock 的审计清单属于源码供应链文件，必须提交。
!backend/fastapi-service/python-lock.manifest.sha256
!backend/worker/python-lock.manifest.sha256

# 编辑器异常退出产生的交换文件不应阻塞虚拟机部署。
*.swp
*.swo
